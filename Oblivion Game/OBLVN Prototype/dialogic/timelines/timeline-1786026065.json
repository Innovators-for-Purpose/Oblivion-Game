			"value": ""
		},
		{
			"character": "character-1784729720.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Well, just in case you forgot, you can go into your inventory by pressing the F KEY. You can equip your Stun Gun there."
		},
		{
			"character": "character-1784729102.json",
			"event_id": "dialogic_001",
			"portrait": "",
			"text": "Thanks Theo, I'll get going!"
		},
		{
